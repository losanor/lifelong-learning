ANTHROPIC_API_KEY=
USE_MOCK_MODEL=true

# LangSmith Developer includes a free trace allowance for a one-person pilot.
# Enable only after adding a local API key and setting a usage limit in LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=squad-v5-lite
# Daily pilot default: sample 20% of normal runs. Use 1.0 only for a measured baseline.
LANGSMITH_TRACING_SAMPLING_RATE=0.2

# Optional authenticated inbound queue for n8n. Does not auto-run agents.
SQUAD_WEBHOOK_TOKEN=
